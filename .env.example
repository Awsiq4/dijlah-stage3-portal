# No secrets are needed for the frontend prototype.
# The following are NOT wired until authenticated backend integrations are built:
# DATABASE_URL=
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_R2_BUCKET=
# OPENAI_KEY=

# ---- Telegram notification bot (server-side only, set in Vercel Environment Variables) ----
# TELEGRAM_BOT_ENABLED=false            # master feature flag; keep false until everything below is set
# TELEGRAM_BOT_TOKEN=                   # from @BotFather (NEVER commit)
# TELEGRAM_BOT_USERNAME=                # bot username without @
# TELEGRAM_WEBHOOK_SECRET=              # random string; Telegram sends it as X-Telegram-Bot-Api-Secret-Token
# SUBSCRIPTION_SECRET=                  # random string for signing short-lived deep-link tokens
# ADMIN_API_SECRET=                     # random string; required header x-admin-secret for /api/telegram/admin
# WORKER_SECRET=                        # random string; required header x-worker-secret for /api/telegram/worker
# DATABASE_URL=                         # Postgres connection string (e.g. Neon); run database/telegram-notifications.sql
# PORTAL_BASE_URL=https://dijlah-stage3-portal.vercel.app
# QSTASH_TOKEN=                         # optional: Upstash QStash token for event-driven delivery
# QSTASH_URL=https://qstash.upstash.io  # optional
